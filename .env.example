# Postgres connection string (local: npm run db:up)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/orcamento
# Better Auth: secret with at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public base URL of the app
BETTER_AUTH_URL=http://localhost:3000
# Single account created by the seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=
