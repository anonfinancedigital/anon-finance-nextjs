# Postgres connection string (local: npm run db:up)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/orcamento
# Better Auth: secret with at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public base URL of the app
BETTER_AUTH_URL=http://localhost:3000
# Single account created by the seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Google OAuth client (Google Cloud Console > Credentials). Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# Leave both empty to hide the "Continuar com Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP server that sends the password reset e-mail
SMTP_HOST=
SMTP_PORT=
# SMTP credentials
SMTP_USER=
SMTP_PASS=
# Sender of the e-mails, e.g. "Orçamento <no-reply@example.com>"
SMTP_FROM=
# Sentry DSN read by the server (leave empty to keep Sentry off)
SENTRY_DSN=
# Same DSN, read by the browser (events go through the /monitoring tunnel)
NEXT_PUBLIC_SENTRY_DSN=
# Sentry auth token, build only: uploads source maps (without it the build skips the upload)
SENTRY_AUTH_TOKEN=
